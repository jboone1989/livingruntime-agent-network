{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityDescriptor",
  "type": "object",
  "required": ["id", "version"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "input_schema": { "type": "object" },
    "output_schema": { "type": "object" },
    "side_effects": { "type": "string", "enum": ["NONE", "REVERSIBLE", "IRREVERSIBLE"] }
  }
}
