{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-network.local/schemas/agent-registration.schema.json",
  "title": "AgentRegistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agent_id",
    "name",
    "agent_card_url",
    "public_key",
    "capabilities"
  ],
  "properties": {
    "agent_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "name": { "type": "string", "minLength": 1, "maxLength": 256 },
    "agent_card_url": { "type": "string", "minLength": 1 },
    "public_key": { "type": "string", "pattern": "^ed25519:" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "signature": { "type": "string", "pattern": "^ed25519:" }
  },
  "not": {
    "anyOf": [
      { "required": ["memory"] },
      { "required": ["prompt"] },
      { "required": ["model"] },
      { "required": ["private_key"] }
    ]
  }
}
