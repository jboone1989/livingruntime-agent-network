{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactRef",
  "type": "object",
  "required": ["artifact_id", "task_id", "producer_agent_id", "sha256"],
  "properties": {
    "artifact_id": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 },
    "task_id": { "type": "string" },
    "producer_agent_id": { "type": "string" },
    "media_type": { "type": "string" },
    "size": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["transport", "url"],
        "properties": {
          "transport": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "inline": {
      "type": "object",
      "properties": {
        "encoding": { "type": "string" },
        "data": { "type": "string" }
      }
    },
    "created_at": { "type": "string" },
    "signature": { "type": "string" },
    "previous_revision_hash": { "type": "string" },
    "owner": { "type": "string" },
    "key_id": { "type": "string" }
  },
  "if": {
    "properties": { "revision": { "minimum": 2 } },
    "required": ["revision"]
  },
  "then": {
    "required": ["previous_revision_hash"]
  }
}
